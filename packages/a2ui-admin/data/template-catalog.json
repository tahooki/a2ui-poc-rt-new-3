  {
    "schemaVersion": 2,
    "templateId": "component_smoke_fulltest",
    "version": "1.0.0",
    "title": "Component Smoke Full Test",
    "status": "draft",
    "description": "Draft template copied from Deploy Launchpad",
    "intents": [
      {
        "intentKey": "component_smoke_fulltest.start",
        "requiredFacts": [],
        "optionalFacts": []
      }
    ],
    "resolvers": [
      {
        "id": "smokeData",
        "kind": "static_defaults",
        "label": "Admin-bound smoke test data",
        "phase": "blocking",
        "outputAlias": "smoke",
        "values": {
          "headline": "Admin data binding is live",
          "summary": "This payload was authored in the Admin catalog and resolved through MCP.",
          "metricLabel": "Smoke score",
          "metricValue": "100%",
          "statusTone": "success",
          "rows": [
            {
              "name": "Admin catalog",
              "value": "template saved",
              "status": "success"
            },
            {
              "name": "MCP resolve",
              "value": "payload generated",
              "status": "success"
            },
            {
              "name": "React renderer",
              "value": "component mounted",
              "status": "info"
            }
          ],
          "footerNote": "Created by the component smoke full test."
        }
      }
    ],
    "bindingRecipeId": "component_smoke_test",
    "actions": [
      {
        "actionId": "smoke.ack",
        "label": "Acknowledge",
        "variant": "primary",
        "kind": "submit",
        "requiredPayloadFields": [
          "headline"
        ],
        "enableWhen": null
      },
      {
        "actionId": "smoke.refresh",
        "label": "Refresh",
        "variant": "ghost",
        "kind": "refresh",
        "requiredPayloadFields": [],
        "enableWhen": null
      }
