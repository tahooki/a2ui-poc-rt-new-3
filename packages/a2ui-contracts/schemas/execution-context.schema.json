{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-context",
  "title": "ExecutionContext",
  "description": "런타임 실행 시 필요한 공통 문맥",
  "type": "object",
  "required": ["user", "org", "conversationId", "sessionId", "requestId", "environment"],
  "properties": {
    "user": {
      "type": "object",
      "required": ["id", "name", "roles"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "org": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "conversationId": { "type": "string" },
    "sessionId": { "type": "string" },
    "requestId": { "type": "string" },
    "selectedEntity": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "environment": {
      "type": "string",
      "enum": ["production", "staging", "development"]
    },
    "modelConfig": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "maxTokens": { "type": "integer" }
      }
    }
  },
  "additionalProperties": false
}
